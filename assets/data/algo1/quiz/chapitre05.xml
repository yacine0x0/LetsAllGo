<?xml version="1.0" encoding="UTF-8"?>
<chapter id="Chapitre_05_Quiz" title="Quiz – Sous-algorithmes (fonctions et procédures)">

  <!-- ==================== QUESTIONS SUR LES FONCTIONS ==================== -->
  <question id="q1" type="multipleChoice">
    <enonce>Qu'est-ce qu'une fonction ?</enonce>
    <choices>
      <choice id="A">Un sous-algorithme qui ne retourne aucune valeur</choice>
      <choice id="B">Un sous-algorithme qui retourne une valeur unique</choice>
      <choice id="C">Une variable globale</choice>
      <choice id="D">Une boucle particulière</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q2" type="multipleChoice">
    <enonce>Qu'est-ce qu'une procédure ?</enonce>
    <choices>
      <choice id="A">Un sous-algorithme qui retourne une valeur</choice>
      <choice id="B">Un sous-algorithme qui ne retourne aucune valeur</choice>
      <choice id="C">Une constante</choice>
      <choice id="D">Un type de donnée</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q3" type="multipleChoice">
    <enonce>Dans une fonction, le résultat est affecté à :</enonce>
    <choices>
      <choice id="A">Une variable locale</choice>
      <choice id="B">L'identifiant de la fonction</choice>
      <choice id="C">Un paramètre</choice>
      <choice id="D">Une constante</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q4" type="multipleChoice">
    <enonce>Une variable globale est définie :</enonce>
    <choices>
      <choice id="A">Dans le corps d'un sous-algorithme</choice>
      <choice id="B">Au niveau de l'algorithme principal (dans VAR)</choice>
      <choice id="C">Dans la partie CONSTANTE</choice>
      <choice id="D">Dans un paramètre</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q5" type="multipleChoice">
    <enonce>Une variable locale est :</enonce>
    <choices>
      <choice id="A">Accessible partout dans l'algorithme</choice>
      <choice id="B">Définie au sein d'un sous-algorithme</choice>
      <choice id="C">Une constante</choice>
      <choice id="D">Un paramètre en sortie</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q6" type="multipleChoice">
    <enonce>Que se passe-t-il si une variable locale a le même nom qu'une variable globale ?</enonce>
    <choices>
      <choice id="A">Erreur de compilation</choice>
      <choice id="B">La variable globale masque la variable locale</choice>
      <choice id="C">La variable locale masque la variable globale</choice>
      <choice id="D">Les deux variables sont fusionnées</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q7" type="multipleChoice">
    <enonce>Quel est l'avantage principal des sous-algorithmes ?</enonce>
    <choices>
      <choice id="A">Ralentir l'exécution</choice>
      <choice id="B">Réutiliser le code et améliorer la lisibilité</choice>
      <choice id="C">Augmenter le nombre de variables</choice>
      <choice id="D">Rendre l'algorithme plus complexe</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q8" type="multipleChoice">
    <enonce>Dans un passage de paramètre en entrée (E) :</enonce>
    <choices>
      <choice id="A">Le sous-algorithme peut modifier la variable appelante</choice>
      <choice id="B">Une copie de la valeur est passée au sous-algorithme</choice>
      <choice id="C">La variable appelante est directement liée au paramètre</choice>
      <choice id="D">On ne peut pas utiliser de constantes</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q9" type="multipleChoice">
    <enonce>Dans un passage de paramètre en sortie (S) :</enonce>
    <choices>
      <choice id="A">La valeur du paramètre est copiée dans la variable appelante à la fin</choice>
      <choice id="B">Le paramètre ne peut pas être modifié</choice>
      <choice id="C">On peut passer une constante</choice>
      <choice id="D">La variable appelante n'est pas affectée</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q10" type="multipleChoice">
    <enonce>Dans un passage de paramètre en entrée/sortie (E/S) :</enonce>
    <choices>
      <choice id="A">Le paramètre est en lecture seule</choice>
      <choice id="B">Le paramètre est en écriture seule</choice>
      <choice id="C">Le paramètre peut être lu et modifié, et les modifications affectent la variable appelante</choice>
      <choice id="D">Une copie est faite sans retour</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q11" type="multipleChoice">
    <enonce>L'instruction LIRE() en algorithmique peut être vue comme :</enonce>
    <choices>
      <choice id="A">Une fonction</choice>
      <choice id="B">Une procédure avec paramètres en sortie</choice>
      <choice id="C">Une constante</choice>
      <choice id="D">Une variable globale</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q12" type="multipleChoice">
    <enonce>Où doit-on déclarer un sous-algorithme ?</enonce>
    <choices>
      <choice id="A">Dans le corps de l'algorithme après DÉBUT</choice>
      <choice id="B">Dans la partie déclaration de l'algorithme, avant DÉBUT</choice>
      <choice id="C">Après FIN de l'algorithme</choice>
      <choice id="D">Dans un fichier séparé</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q13" type="multipleChoice">
    <enonce>Quelle est la différence fondamentale entre une fonction et une procédure ?</enonce>
    <choices>
      <choice id="A">La fonction retourne une valeur, la procédure non</choice>
      <choice id="B">La procédure retourne une valeur, la fonction non</choice>
      <choice id="C">La fonction a des paramètres, la procédure non</choice>
      <choice id="D">Il n'y a pas de différence</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q14" type="multipleChoice">
    <enonce>Dans l'exemple de la permutation, le passage des paramètres est :</enonce>
    <choices>
      <choice id="A">En entrée</choice>
      <choice id="B">En sortie</choice>
      <choice id="C">En entrée/sortie</choice>
      <choice id="D">Par valeur</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q15" type="multipleChoice">
    <enonce>La fonction Fact(x) dans l'exemple de combinaison calcule :</enonce>
    <choices>
      <choice id="A">La somme des entiers de 1 à x</choice>
      <choice id="B">La factorielle de x (x! = 1*2*...*x)</choice>
      <choice id="C">Le carré de x</choice>
      <choice id="D">La racine carrée de x</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q16" type="multipleChoice">
    <enonce>Dans l'appel Max(x, y, grand), le paramètre grand est passé :</enonce>
    <choices>
      <choice id="A">En entrée</choice>
      <choice id="B">En sortie</choice>
      <choice id="C">En entrée/sortie</choice>
      <choice id="D">Par valeur</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q17" type="multipleChoice">
    <enonce>La structuration d'un algorithme par modules est la base de :</enonce>
    <choices>
      <choice id="A">La programmation séquentielle</choice>
      <choice id="B">La programmation structurée et modulaire</choice>
      <choice id="C">La programmation linéaire</choice>
      <choice id="D">La programmation récursive</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q18" type="multipleChoice">
    <enonce>Un paramètre formel est :</enonce>
    <choices>
      <choice id="A">Une variable passée lors de l'appel</choice>
      <choice id="B">Une variable déclarée dans la définition du sous-algorithme</choice>
      <choice id="C">Une constante globale</choice>
      <choice id="D">Le résultat de la fonction</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q19" type="multipleChoice">
    <enonce>Un paramètre effectif est :</enonce>
    <choices>
      <choice id="A">La variable ou valeur passée lors de l'appel</choice>
      <choice id="B">La variable déclarée dans la définition</choice>
      <choice id="C">Le résultat de la fonction</choice>
      <choice id="D">Une constante locale</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q20" type="multipleChoice">
    <enonce>L'appel à une fonction peut être utilisé :</enonce>
    <choices>
      <choice id="A">Comme une instruction seule</choice>
      <choice id="B">Dans une expression</choice>
      <choice id="C">Uniquement comme paramètre</choice>
      <choice id="D">Uniquement comme condition</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q21" type="multipleChoice">
    <enonce>L'appel à une procédure s'utilise :</enonce>
    <choices>
      <choice id="A">Comme une instruction seule</choice>
      <choice id="B">Dans une expression</choice>
      <choice id="C">Uniquement comme paramètre</choice>
      <choice id="D">Avec return</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q22" type="multipleChoice">
    <enonce>Quel est l'intérêt de la fonction factorielle dans l'exemple combinaison ?</enonce>
    <choices>
      <choice id="A">Éviter la répétition du code de calcul de factorielle</choice>
      <choice id="B">Ralentir l'exécution</choice>
      <choice id="C">Utiliser plus de variables</choice>
      <choice id="D">Rendre l'algorithme plus long</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q23" type="multipleChoice">
    <enonce>Une variable déclarée à l'intérieur d'une procédure est :</enonce>
    <choices>
      <choice id="A">Globale</choice>
      <choice id="B">Locale à la procédure</choice>
      <choice id="C">Accessible depuis l'algorithme principal</choice>
      <choice id="D">Une constante</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <!-- ==================== ORDRE ==================== -->
  <question id="q24" type="ordering">
    <enonce>Remettez dans l'ordre les parties d'un algorithme avec sous-algorithmes :</enonce>
    <bonneReponse>ALGORITHME|CONSTANTE|VARIABLE|FONCTION/PROCÉDURE|DÉBUT|FIN</bonneReponse>
    <codeLines>
      <line>VARIABLE</line>
      <line>FONCTION/PROCÉDURE</line>
      <line>ALGORITHME</line>
      <line>FIN</line>
      <line>CONSTANTE</line>
      <line>DÉBUT</line>
    </codeLines>
  </question>

  <question id="q25" type="ordering">
    <enonce>Remettez dans l'ordre les étapes d'appel d'une fonction :</enonce>
    <bonneReponse>Appel de la fonction|Passage des paramètres|Exécution du corps|Retour du résultat|Utilisation du résultat</bonneReponse>
    <codeLines>
      <line>Passage des paramètres</line>
      <line>Retour du résultat</line>
      <line>Utilisation du résultat</line>
      <line>Exécution du corps</line>
      <line>Appel de la fonction</line>
    </codeLines>
  </question>

  <question id="q26" type="ordering">
    <enonce>Remettez dans l'ordre la déclaration correcte d'une fonction :</enonce>
    <bonneReponse>FONCTION|Nom|(paramètres)|: Type|DÉBUT|FIN</bonneReponse>
    <codeLines>
      <line>FIN</line>
      <line>DÉBUT</line>
      <line>FONCTION</line>
      <line>Nom</line>
      <line>: Type</line>
      <line>(paramètres)</line>
    </codeLines>
  </question>

  <!-- ==================== QUESTIONS SUR L'EXEMPLE COMBINAISON ==================== -->
  <question id="q27" type="multipleChoice">
    <enonce>Dans l'algorithme combinaison amélioré, combien de fois la fonction Fact est-elle appelée ?</enonce>
    <choices>
      <choice id="A">1 fois</choice>
      <choice id="B">2 fois</choice>
      <choice id="C">3 fois</choice>
      <choice id="D">4 fois</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q28" type="multipleChoice">
    <enonce>Dans la fonction Fact, la variable r est initialisée à :</enonce>
    <choices>
      <choice id="A">0</choice>
      <choice id="B">1</choice>
      <choice id="C">x</choice>
      <choice id="D">n</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q29" type="multipleChoice">
    <enonce>Le passage de paramètres en entrée est aussi appelé :</enonce>
    <choices>
      <choice id="A">Passage par référence</choice>
      <choice id="B">Passage par valeur</choice>
      <choice id="C">Passage par adresse</choice>
      <choice id="D">Passage par pointeur</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q30" type="multipleChoice">
    <enonce>Le passage de paramètres en entrée/sortie est aussi appelé :</enonce>
    <choices>
      <choice id="A">Passage par valeur</choice>
      <choice id="B">Passage par référence</choice>
      <choice id="C">Passage par copie</choice>
      <choice id="D">Passage par constante</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

</chapter>