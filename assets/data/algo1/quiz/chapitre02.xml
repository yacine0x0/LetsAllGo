<chapter id="Chapitre_02" title="Conditions - Structures conditionnelles">

  <!-- ==================== MULTIPLE CHOICE QUESTIONS (20) ==================== -->

  <question id="c2_q1" type="multipleChoice">
    <enonce>What does an "if-else" statement do?</enonce>
    <choices>
      <choice id="A">Variable declaration</choice>
      <choice id="B">Function definition</choice>
      <choice id="C">Conditional execution</choice>
      <choice id="D">Loop execution</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c2_q2" type="multipleChoice">
    <enonce>Which keyword is used for multiple conditions?</enonce>
    <choices>
      <choice id="A">while</choice>
      <choice id="B">for</choice>
      <choice id="C">foreach</choice>
      <choice id="D">switch</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="c2_q3" type="multipleChoice">
    <enonce>What is the logical operator for AND?</enonce>
    <choices>
      <choice id="A">||</choice>
      <choice id="B">|</choice>
      <choice id="C">&amp;&amp;</choice>
      <choice id="D">&amp;</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c2_q4" type="multipleChoice">
    <enonce>What is the logical operator for OR?</enonce>
    <choices>
      <choice id="A">&amp;&amp;</choice>
      <choice id="B">||</choice>
      <choice id="C">!</choice>
      <choice id="D">&amp;</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c2_q5" type="multipleChoice">
    <enonce>What does the NOT operator (!) do?</enonce>
    <choices>
      <choice id="A">Adds two numbers</choice>
      <choice id="B">Inverts a boolean value</choice>
      <choice id="C">Compares two values</choice>
      <choice id="D">Declares a variable</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c2_q6" type="multipleChoice">
    <enonce>What is the result of (true &amp;&amp; false)?</enonce>
    <choices>
      <choice id="A">true</choice>
      <choice id="B">null</choice>
      <choice id="C">false</choice>
      <choice id="D">error</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c2_q7" type="multipleChoice">
    <enonce>What is the result of (false || true)?</enonce>
    <choices>
      <choice id="A">false</choice>
      <choice id="B">true</choice>
      <choice id="C">null</choice>
      <choice id="D">error</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c2_q8" type="multipleChoice">
    <enonce>Which statement executes a block of code if the condition is false?</enonce>
    <choices>
      <choice id="A">if</choice>
      <choice id="B">for</choice>
      <choice id="C">else</choice>
      <choice id="D">switch</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c2_q9" type="multipleChoice">
    <enonce>What is the ternary operator used for?</enonce>
    <choices>
      <choice id="A">Defining functions</choice>
      <choice id="B">Looping through arrays</choice>
      <choice id="C">A shorthand for if-else in a single line</choice>
      <choice id="D">Declaring variables</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c2_q11" type="multipleChoice">
    <enonce>What is the result of (!true)?</enonce>
    <choices>
      <choice id="A">true</choice>
      <choice id="B">1</choice>
      <choice id="C">false</choice>
      <choice id="D">null</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c2_q12" type="multipleChoice">
    <enonce>In a switch statement, what happens if no case matches and there is no default?</enonce>
    <choices>
      <choice id="A">An error is thrown</choice>
      <choice id="B">The program stops</choice>
      <choice id="C">Nothing happens, execution continues after the switch</choice>
      <choice id="D">The first case executes</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c2_q13" type="multipleChoice">
    <enonce>What is short-circuit evaluation?</enonce>
    <choices>
      <choice id="A">Evaluating all conditions regardless of the result</choice>
      <choice id="B">Stopping evaluation of a logical expression as soon as the result is determined</choice>
      <choice id="C">A way to shorten code by removing conditions</choice>
      <choice id="D">Using ternary operators instead of if-else</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c2_q14" type="multipleChoice">
    <enonce>What does "else if" allow you to do?</enonce>
    <choices>
      <choice id="A">Declare multiple variables</choice>
      <choice id="B">Check multiple conditions sequentially</choice>
      <choice id="C">Loop through multiple values</choice>
      <choice id="D">Define a function with conditions</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c2_q15" type="multipleChoice">
    <enonce>What is the result of (false &amp;&amp; false)?</enonce>
    <choices>
      <choice id="A">true</choice>
      <choice id="B">undefined</choice>
      <choice id="C">false</choice>
      <choice id="D">null</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c2_q16" type="multipleChoice">
    <enonce>Which operator checks both value and type equality?</enonce>
    <choices>
      <choice id="A">==</choice>
      <choice id="B">!=</choice>
      <choice id="C">===</choice>
      <choice id="D">=</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c2_q17" type="multipleChoice">
    <enonce>What is a boolean expression?</enonce>
    <choices>
      <choice id="A">An expression that returns a number</choice>
      <choice id="B">An expression used only in loops</choice>
      <choice id="C">An expression that evaluates to true or false</choice>
      <choice id="D">An expression that defines a variable</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c2_q18" type="multipleChoice">
    <enonce>What is the result of (true || false)?</enonce>
    <choices>
      <choice id="A">false</choice>
      <choice id="B">null</choice>
      <choice id="C">error</choice>
      <choice id="D">true</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="c2_q19" type="multipleChoice">
    <enonce>In a switch statement, what is the purpose of "break"?</enonce>
    <choices>
      <choice id="A">To skip the current case</choice>
      <choice id="B">To stop execution and exit the switch block</choice>
      <choice id="C">To exit the program</choice>
      <choice id="D">To restart the switch</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c2_q21" type="multipleChoice">
