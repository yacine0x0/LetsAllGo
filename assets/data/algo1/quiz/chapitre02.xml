    <choices>
      <choice id="A">false</choice>
      <choice id="B">true</choice>
      <choice id="C">null</choice>
      <choice id="D">error</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c2_q22" type="multipleChoice">
    <enonce>Which comparison operator means "not equal to"?</enonce>
    <choices>
      <choice id="A">==</choice>
      <choice id="B">&gt;=</choice>
      <choice id="C">!=</choice>
      <choice id="D">&lt;=</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <!-- ==================== ORDERING QUESTIONS (10) ==================== -->

  <question id="c2_q10" type="ordering">
    <enonce>Order the steps of an if-else execution:</enonce>
    <bonneReponse>Evaluate condition|Check if true|Execute if block|Execute else block</bonneReponse>
    <codeLines>
      <line>Execute if block</line>
      <line>Evaluate condition</line>
      <line>Execute else block</line>
      <line>Check if true</line>
    </codeLines>
  </question>

  <question id="c2_q20" type="ordering">
    <enonce>Order the steps of a switch statement execution:</enonce>
    <bonneReponse>Evaluate expression|Compare to first case|Match found: execute case|Break: exit switch</bonneReponse>
    <codeLines>
      <line>Break: exit switch</line>
      <line>Compare to first case</line>
      <line>Evaluate expression</line>
      <line>Match found: execute case</line>
    </codeLines>
  </question>

  <question id="c2_q23" type="ordering">
    <enonce>Order the logical operators by precedence (highest first):</enonce>
    <bonneReponse>NOT (!)|AND (&amp;&amp;)|OR (||)</bonneReponse>
    <codeLines>
      <line>AND (&amp;&amp;)</line>
      <line>OR (||)</line>
      <line>NOT (!)</line>
    </codeLines>
  </question>

  <question id="c2_q24" type="ordering">
    <enonce>Order the steps to evaluate (true || false) &amp;&amp; false:</enonce>
    <bonneReponse>Evaluate true OR false|Result is true|Evaluate true AND false|Result is false</bonneReponse>
    <codeLines>
      <line>Evaluate true AND false</line>
      <line>Result is true</line>
      <line>Evaluate true OR false</line>
      <line>Result is false</line>
    </codeLines>
  </question>

  <question id="c2_q25" type="ordering">
    <enonce>Order the parts of an if-else if-else structure:</enonce>
    <bonneReponse>if (condition1)|else if (condition2)|else|execute appropriate block</bonneReponse>
    <codeLines>
      <line>else if (condition2)</line>
      <line>execute appropriate block</line>
      <line>if (condition1)</line>
      <line>else</line>
    </codeLines>
  </question>

  <question id="c2_q26" type="ordering">
    <enonce>Order the steps of ternary operator evaluation:</enonce>
    <bonneReponse>Evaluate condition|Condition true: use value_if_true|Condition false: use value_if_false|Assign result to variable</bonneReponse>
    <codeLines>
      <line>Assign result to variable</line>
      <line>Condition false: use value_if_false</line>
      <line>Condition true: use value_if_true</line>
      <line>Evaluate condition</line>
    </codeLines>
  </question>

  <question id="c2_q27" type="ordering">
    <enonce>Order the evaluation of (!false || true) &amp;&amp; false:</enonce>
    <bonneReponse>NOT false = true|true OR true = true|true AND false = false</bonneReponse>
    <codeLines>
      <line>true AND false = false</line>
      <line>true OR true = true</line>
      <line>NOT false = true</line>
    </codeLines>
  </question>

  <question id="c2_q28" type="ordering">
    <enonce>Order the switch statement components from first to last:</enonce>
    <bonneReponse>switch (expression)|case value:|break;|default:</bonneReponse>
    <codeLines>
      <line>break;</line>
      <line>case value:</line>
      <line>default:</line>
      <line>switch (expression)</line>
    </codeLines>
  </question>

  <question id="c2_q29" type="ordering">
    <enonce>Order the steps of nested if-else execution:</enonce>
    <bonneReponse>Enter outer if|Check outer condition true|Enter inner if|Execute inner if block</bonneReponse>
    <codeLines>
      <line>Enter inner if</line>
      <line>Check outer condition true</line>
      <line>Execute inner if block</line>
      <line>Enter outer if</line>
    </codeLines>
  </question>

  <question id="c2_q30" type="ordering">
    <enonce>Order the correct syntax for an if-else statement:</enonce>
    <bonneReponse>if (condition) {|// if block| } else {|// else block| }</bonneReponse>
    <codeLines>
      <line> } else {</line>
      <line>if (condition) {</line>
      <line>// else block</line>
      <line>// if block</line>
      <line> }</line>
    </codeLines>
  </question>

