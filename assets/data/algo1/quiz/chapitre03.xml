<?xml version="1.0" encoding="UTF-8"?>
<chapter id="Chapitre_03_Quiz" title="Quiz – Structures répétitives (boucles)">

  <!-- ==================== EXERCICE PAGE 8 ==================== -->
  <question id="q1" type="multipleChoice">
    <enonce>On peut utiliser la boucle POUR ... FAIRE pour afficher la table de multiplication d'un entier introduit par l'utilisateur.</enonce>
    <choices>
      <choice id="A">Vrai</choice>
      <choice id="B">Faux</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <!-- ==================== EXERCICE PAGE 9 ==================== -->
  <question id="q2" type="multipleChoice">
    <enonce>On peut calculer la somme d'une succession d'entiers introduits progressivement (un par un) à chaque tour de boucle.</enonce>
    <choices>
      <choice id="A">Vrai</choice>
      <choice id="B">Faux</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <!-- ==================== EXERCICE PAGE 13 ==================== -->
  <question id="q3" type="multipleChoice">
    <enonce>La boucle TANT QUE ... FAIRE se base sur une condition d'entrée, et une mise à jour automatique de la condition. La boucle s'arrête lorsque la condition n'est plus vérifiée.</enonce>
    <choices>
      <choice id="A">Vrai</choice>
      <choice id="B">Faux</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <!-- ==================== EXERCICE PAGE 17 ==================== -->
  <question id="q4" type="multipleChoice">
    <enonce>Choisir la(les) bonne(s) réponse(s) concernant la boucle RÉPÉTER ... JUSQU'À :</enonce>
    <choices>
      <choice id="A">Elle est basée sur le nombre de tours de boucle</choice>
      <choice id="B">Elle est basée sur une condition de sortie</choice>
      <choice id="C">Elle est similaire à la boucle POUR ... FAIRE</choice>
      <choice id="D">Contrairement à TANT QUE, elle doit boucler au moins une fois</choice>
    </choices>
    <bonneReponse>B,D</bonneReponse>
  </question>

  <!-- ==================== EXERCICE PAGE 19 ==================== -->
  <question id="q5" type="multipleChoice">
    <enonce>Tous les types de boucles sont des instructions de contrôle.</enonce>
    <choices>
      <choice id="A">Vrai</choice>
      <choice id="B">Faux</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q6" type="multipleChoice">
    <enonce>Que permet de faire une boucle ?</enonce>
    <choices>
      <choice id="A">Attribuer une valeur à une variable</choice>
      <choice id="B">Répéter certaines actions plusieurs fois</choice>
      <choice id="C">Initialiser les constantes d'un algorithme</choice>
      <choice id="D">Réduire la longueur d'un algorithme en évitant la réécriture d'instructions</choice>
    </choices>
    <bonneReponse>B,D</bonneReponse>
  </question>

  <question id="q7" type="multipleChoice">
    <enonce>Peut-on insérer une boucle dans une autre ?</enonce>
    <choices>
      <choice id="A">Oui</choice>
      <choice id="B">Non</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <!-- ==================== QUESTIONS SUPPLÉMENTAIRES (PETITS AJOUTS) ==================== -->
  <question id="q8" type="multipleChoice">
    <enonce>La boucle POUR ... FAIRE est particulièrement adaptée quand :</enonce>
    <choices>
      <choice id="A">Le nombre d'itérations est inconnu</choice>
      <choice id="B">Le nombre d'itérations est connu à l'avance</choice>
      <choice id="C">On doit exécuter la boucle au moins une fois</choice>
      <choice id="D">La condition est complexe</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q9" type="multipleChoice">
    <enonce>Dans une boucle TANT QUE, si la condition est fausse dès le départ :</enonce>
    <choices>
      <choice id="A">La boucle s'exécute une fois</choice>
      <choice id="B">La boucle s'exécute indéfiniment</choice>
      <choice id="C">On n'entre pas dans la boucle</choice>
      <choice id="D">Il y a une erreur de syntaxe</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q10" type="multipleChoice">
    <enonce>Que se passe-t-il si on oublie la mise à jour de la condition dans une boucle TANT QUE ?</enonce>
    <choices>
      <choice id="A">La boucle s'arrête normalement</choice>
      <choice id="B">La boucle devient infinie</choice>
      <choice id="C">Le programme plante immédiatement</choice>
      <choice id="D">La condition devient automatiquement fausse</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q11" type="multipleChoice">
    <enonce>La boucle RÉPÉTER ... JUSQU'À garantit que le traitement est exécuté :</enonce>
    <choices>
      <choice id="A">0 fois</choice>
      <choice id="B">Au moins 1 fois</choice>
      <choice id="C">Au moins 2 fois</choice>
      <choice id="D">Un nombre connu de fois</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q12" type="multipleChoice">
    <enonce>Dans RÉPÉTER ... JUSQU'À, on sort de la boucle quand :</enonce>
    <choices>
      <choice id="A">La condition est vraie</choice>
      <choice id="B">La condition est fausse</choice>
      <choice id="C">Le compteur dépasse la valeur finale</choice>
      <choice id="D">On atteint le nombre d'itérations</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q13" type="multipleChoice">
    <enonce>Quel type de boucle est le plus approprié pour afficher les nombres de 1 à 10 ?</enonce>
    <choices>
      <choice id="A">POUR</choice>
      <choice id="B">TANT QUE</choice>
      <choice id="C">RÉPÉTER...JUSQU'À</choice>
      <choice id="D">Les trois sont possibles</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q14" type="multipleChoice">
    <enonce>Quel type de boucle est le plus approprié pour contrôler la saisie d'une note entre 0 et 20 ?</enonce>
    <choices>
      <choice id="A">POUR</choice>
      <choice id="B">TANT QUE</choice>
      <choice id="C">RÉPÉTER...JUSQU'À</choice>
      <choice id="D">Aucune</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q15" type="multipleChoice">
    <enonce>Soit l'algorithme : i ← 1 ; TANT QUE (i &lt;= 5) FAIRE ÉCRIRE(i) ; i ← i+1 ; FIN TANT QUE. Combien de nombres sont affichés ?</enonce>
    <choices>
      <choice id="A">4</choice>
      <choice id="B">5</choice>
      <choice id="C">6</choice>
      <choice id="D">0</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q16" type="multipleChoice">
    <enonce>Soit l'algorithme : i ← 1 ; TANT QUE (i &gt; 5) FAIRE ÉCRIRE(i) ; i ← i+1 ; FIN TANT QUE. Combien de nombres sont affichés ?</enonce>
    <choices>
      <choice id="A">5</choice>
      <choice id="B">1</choice>
      <choice id="C">0</choice>
      <choice id="D">Infini</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q17" type="multipleChoice">
    <enonce>Quelle est la valeur de S après : S←0 ; POUR i ALLANT DE 1 A 3 FAIRE S←S+i ; FIN POUR ?</enonce>
    <choices>
      <choice id="A">3</choice>
      <choice id="B">5</choice>
      <choice id="C">6</choice>
      <choice id="D">7</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q18" type="multipleChoice">
    <enonce>Une boucle infinie est une boucle :</enonce>
    <choices>
      <choice id="A">Qui ne s'exécute jamais</choice>
      <choice id="B">Qui s'exécute un nombre très grand de fois</choice>
      <choice id="C">Dont la condition d'arrêt n'est jamais atteinte</choice>
      <choice id="D">Qui contient une erreur de syntaxe</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q19" type="multipleChoice">
    <enonce>Dans une boucle POUR, le compteur est automatiquement :</enonce>
    <choices>
      <choice id="A">Incrémenté de 1</choice>
      <choice id="B">Incrémenté de la valeur choisie par l'utilisateur</choice>
      <choice id="C">Décrémenté de 1</choice>
      <choice id="D">Mis à jour manuellement</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q20" type="multipleChoice">
    <enonce>Les boucles sont également appelées :</enonce>
    <choices>
      <choice id="A">Instructions conditionnelles</choice>
      <choice id="B">Structures séquentielles</choice>
      <choice id="C">Structures répétitives</choice>
      <choice id="D">Instructions d'affectation</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q21" type="multipleChoice">
    <enonce>Peut-on transformer une boucle POUR en boucle TANT QUE ?</enonce>
    <choices>
      <choice id="A">Oui, toujours</choice>
      <choice id="B">Non, jamais</choice>
      <choice id="C">Parfois, selon le contexte</choice>
      <choice id="D">Uniquement pour les nombres pairs</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q22" type="multipleChoice">
    <enonce>Lequel de ces énoncés est vrai concernant la boucle POUR ?</enonce>
    <choices>
      <choice id="A">On doit initialiser le compteur manuellement avant la boucle</choice>
      <choice id="B">Le compteur s'incrémente automatiquement</choice>
      <choice id="C">La condition est vérifiée à la sortie</choice>
      <choice id="D">La boucle s'exécute au moins une fois</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q23" type="multipleChoice">
    <enonce>Lequel de ces énoncés est vrai concernant la boucle TANT QUE ?</enonce>
    <choices>
      <choice id="A">Le compteur s'incrémente automatiquement</choice>
      <choice id="B">La condition est vérifiée à la sortie</choice>
      <choice id="C">On peut ne jamais entrer dans la boucle</choice>
      <choice id="D">La boucle s'exécute toujours au moins une fois</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q24" type="multipleChoice">
    <enonce>Lequel de ces énoncés est vrai concernant la boucle RÉPÉTER...JUSQU'À ?</enonce>
    <choices>
      <choice id="A">On peut ne jamais entrer dans la boucle</choice>
      <choice id="B">La condition est vérifiée à l'entrée</choice>
      <choice id="C">La boucle s'exécute au moins une fois</choice>
      <choice id="D">Le compteur s'incrémente automatiquement</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <!-- ==================== ORDRE ==================== -->
  <question id="q25" type="ordering">
    <enonce>Remettez dans l'ordre les mots pour former la syntaxe correcte de POUR ... FAIRE :</enonce>
    <bonneReponse>POUR|compteur|ALLANT DE|valeur_initiale|A|valeur_finale|FAIRE|Traitement|FIN POUR</bonneReponse>
    <codeLines>
      <line>FAIRE</line>
      <line>A</line>
      <line>ALLANT DE</line>
      <line>Traitement</line>
      <line>compteur</line>
      <line>FIN POUR</line>
      <line>POUR</line>
      <line>valeur_initiale</line>
      <line>valeur_finale</line>
    </codeLines>
  </question>

  <question id="q26" type="ordering">
    <enonce>Remettez dans l'ordre les mots pour former la syntaxe correcte de TANT QUE :</enonce>
    <bonneReponse>TANT QUE|(condition)|FAIRE|Traitement|FIN TANT QUE</bonneReponse>
    <codeLines>
      <line>FIN TANT QUE</line>
      <line>(condition)</line>
      <line>FAIRE</line>
      <line>Traitement</line>
      <line>TANT QUE</line>
    </codeLines>
  </question>

  <question id="q27" type="ordering">
    <enonce>Remettez dans l'ordre les mots pour former la syntaxe correcte de RÉPÉTER...JUSQU'À :</enonce>
    <bonneReponse>RÉPÉTER|Traitement|JUSQU'À|(condition)</bonneReponse>
    <codeLines>
      <line>Traitement</line>
      <line>(condition)</line>
      <line>RÉPÉTER</line>
      <line>JUSQU'À</line>
    </codeLines>
  </question>

  <!-- ==================== QUESTIONS DE TRACE ==================== -->
  <question id="q28" type="multipleChoice">
    <enonce>Qu'affiche l'algorithme suivant ?<br/>
i ← 1<br/>
TANT QUE (i &lt; 3) FAIRE<br/>
  ÉCRIRE(i)<br/>
  i ← i + 1<br/>
FIN TANT QUE</enonce>
    <choices>
      <choice id="A">1</choice>
      <choice id="B">1 2</choice>
      <choice id="C">1 2 3</choice>
      <choice id="D">Rien</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q29" type="multipleChoice">
    <enonce>Qu'affiche l'algorithme suivant ?<br/>
i ← 1<br/>
RÉPÉTER<br/>
  ÉCRIRE(i)<br/>
  i ← i + 1<br/>
JUSQU'À (i &gt; 3)</enonce>
    <choices>
      <choice id="A">1</choice>
      <choice id="B">1 2</choice>
      <choice id="C">1 2 3</choice>
      <choice id="D">1 2 3 4</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q30" type="multipleChoice">
    <enonce>Une boucle POUR i ALLANT DE 1 A n FAIRE ... FIN POUR effectue combien d'itérations ?</enonce>
    <choices>
      <choice id="A">n-1</choice>
      <choice id="B">n</choice>
      <choice id="C">n+1</choice>
      <choice id="D">2n</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

</chapter>