<?xml version="1.0" encoding="UTF-8"?>
<chapter id="Chapitre_04_Quiz" title="Quiz – Vecteurs et matrices">

  <!-- ==================== EXERCICE PAGE 10 ==================== -->
  <question id="q1" type="multipleChoice">
    <enonce>Lesquelles des affirmations suivantes sont correctes ?</enonce>
    <choices>
      <choice id="A">A dynamic array that can grow or shrink</choice>
      <choice id="B">A fixed-size array</choice>
      <choice id="C">A constant value</choice>
      <choice id="D">A function parameter</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <!-- ==================== EXERCICE PAGE 14 ==================== -->
  <question id="q2" type="multipleChoice">
    <enonce>Lesquelles des affirmations suivantes sont correctes ?</enonce>
    <choices>
      <choice id="A">O(log n)</choice>
      <choice id="B">O(1)</choice>
      <choice id="C">O(n)</choice>
      <choice id="D">O(n²)</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <!-- ==================== TEST PAGE 15 ==================== -->
  <question id="q3" type="multipleChoice">
    <enonce>En algorithmique, dans un vecteur V de N cases, la première case a pour indice ___ et le contenu de cette case est accessible en utilisant l'instruction ___.</enonce>
    <choices>
      <choice id="A">A one-dimensional array</choice>
      <choice id="B">A dynamic array</choice>
      <choice id="C">A two-dimensional array</choice>
      <choice id="D">A type of vector</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q4" type="multipleChoice">
    <enonce>On considère deux tableaux T1 et T2. Peut-on copier le contenu de T2 dans T1 sans perdre d'information ?</enonce>
    <choices>
      <choice id="A">Less memory usage</choice>
      <choice id="B">Faster access</choice>
      <choice id="C">No advantages</choice>
      <choice id="D">Dynamic sizing</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q5" type="multipleChoice">
    <enonce>Quelle(s) déclaration(s) correspond(ent) à une matrice de N lignes et M colonnes ?</enonce>
    <choices>
      <choice id="A">1</choice>
      <choice id="B">-1</choice>
      <choice id="C">Depends on the language</choice>
      <choice id="D">0</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <!-- ==================== QUESTIONS SUPPLÉMENTAIRES (AJOUTS MINIMES) ==================== -->
  <question id="q6" type="multipleChoice">
    <enonce>Quel type d'allocation mémoire correspond à un tableau déclaré avec une taille fixe ?</enonce>
    <choices>
      <choice id="A">The array resizes automatically</choice>
      <choice id="B">Returns null</choice>
      <choice id="C">An error or exception is thrown</choice>
      <choice id="D">Returns 0</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="q7" type="multipleChoice">
    <enonce>Dans un vecteur, les valeurs sont repérées par :</enonce>
    <choices>
      <choice id="A">O(log n)</choice>
      <choice id="B">O(1)</choice>
      <choice id="C">O(n)</choice>
      <choice id="D">O(n²)</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q8" type="multipleChoice">
    <enonce>La déclaration "Note : TABLEAU [1 .. 10] DE Réel" crée un vecteur contenant :</enonce>
    <choices>
      <choice id="A">m * n</choice>
      <choice id="B">m + n</choice>
      <choice id="C">m / n</choice>
      <choice id="D">m - n</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q9" type="multipleChoice">
    <enonce>Pour accéder à la valeur de la 3ème case d'un vecteur T, on écrit :</enonce>
    <choices>
      <choice id="A">O(n²)</choice>
      <choice id="B">O(log n)</choice>
      <choice id="C">O(1)</choice>
      <choice id="D">O(n)</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="c4_q12" type="multipleChoice">
    <enonce>How is a 2D array element accessed?</enonce>
    <choices>
      <choice id="A">array.get(i, j)</choice>
      <choice id="B">array[i][j]</choice>
      <choice id="C">array[i]</choice>
      <choice id="D">array(i, j)</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="q10" type="multipleChoice">
    <enonce>L'instruction "T[5] &lt;- 12" signifie :</enonce>
    <choices>
      <choice id="A">n+1</choice>
      <choice id="B">n</choice>
      <choice id="C">n-1</choice>
      <choice id="D">n/2</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q11" type="multipleChoice">
    <enonce>Pour initialiser un vecteur de 10 cases avec des valeurs saisies par l'utilisateur, on utilise :</enonce>
    <choices>
      <choice id="A">A matrix with only one row</choice>
      <choice id="B">A matrix where most elements are zero</choice>
      <choice id="C">A matrix with all elements equal to zero</choice>
      <choice id="D">A matrix that cannot be traversed</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q12" type="multipleChoice">
    <enonce>Dans l'algorithme de recherche séquentielle, la condition d'arrêt de la boucle TANT QUE est :</enonce>
    <choices>
      <choice id="A">Storing elements in random order</choice>
      <choice id="B">Storing elements column by column</choice>
      <choice id="C">Storing elements row by row</choice>
      <choice id="D">Storing only non-zero elements</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q13" type="multipleChoice">
    <enonce>Une matrice se différencie d'un vecteur par :</enonce>
    <choices>
      <choice id="A">Le nombre de dimensions (2 au lieu de 1)</choice>
      <choice id="B">Le type de données stockées</choice>
      <choice id="C">La taille maximale</choice>
      <choice id="D">La couleur d'affichage</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="q14" type="multipleChoice">
    <enonce>Pour remplir une matrice de dimensions L x C, on utilise :</enonce>
    <choices>
      <choice id="A">O(n)</choice>
      <choice id="B">O(n²)</choice>
      <choice id="C">O(log n)</choice>
      <choice id="D">O(1) amortized</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q15" type="multipleChoice">
    <enonce>Dans une matrice carrée, la diagonale principale correspond aux éléments où :</enonce>
    <choices>
      <choice id="A">Sorting rows before storing</choice>
      <choice id="B">Storing matrix elements row by row in memory</choice>
      <choice id="C">Storing matrix elements column by column</choice>
      <choice id="D">Accessing only the first row</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q16" type="multipleChoice">
    <enonce>La déclaration "Achat : TABLEAU [1 .. 100, 1 .. 100] d'Entier" contient combien d'éléments ?</enonce>
    <choices>
      <choice id="A">7 elements</choice>
      <choice id="B">12 elements</choice>
      <choice id="C">4 elements</choice>
      <choice id="D">3 elements</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q17" type="multipleChoice">
    <enonce>Dans la recherche séquentielle d'un vecteur, si la valeur recherchée n'existe pas, l'algorithme affichera :</enonce>
    <choices>
      <choice id="A">La position 0</choice>
      <choice id="B">La dernière case du vecteur</choice>
      <choice id="C">Un message indiquant que la valeur n'existe pas</choice>
      <choice id="D">Une erreur</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q18" type="multipleChoice">
    <enonce>L'allocation statique se caractérise par :</enonce>
    <choices>
      <choice id="A">The last column of the matrix</choice>
      <choice id="B">Elements where the row index equals the column index</choice>
      <choice id="C">The first row of the matrix</choice>
      <choice id="D">Elements at even positions</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q19" type="multipleChoice">
    <enonce>Dans l'algorithme d'addition de deux vecteurs, la somme se fait :</enonce>
    <choices>
      <choice id="A">An error is thrown</choice>
      <choice id="B">It reallocates with a larger capacity (typically doubles)</choice>
      <choice id="C">The oldest element is removed</choice>
      <choice id="D">The array becomes fixed-size</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q20" type="multipleChoice">
    <enonce>Pour afficher tous les éléments d'une matrice, on doit utiliser :</enonce>
    <choices>
      <choice id="A">Add the matrix to itself</choice>
      <choice id="B">Swap rows and columns (matrix[i][j] becomes matrix[j][i])</choice>
      <choice id="C">Reverse all rows</choice>
      <choice id="D">Multiply all elements by -1</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q21" type="multipleChoice">
    <enonce>Quelle est l'utilité principale des tableaux (vecteurs et matrices) ?</enonce>
    <choices>
      <choice id="A">A matrix where all rows are equal</choice>
      <choice id="B">A matrix with 1s on the diagonal and 0s elsewhere</choice>
      <choice id="C">A matrix filled with 1s</choice>
      <choice id="D">A matrix with all zeros</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q22" type="multipleChoice">
    <enonce>Dans un vecteur, l'indice doit être de type :</enonce>
    <choices>
      <choice id="A">O(n²)</choice>
      <choice id="B">O(log n)</choice>
      <choice id="C">O(n)</choice>
      <choice id="D">O(1)</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q23" type="multipleChoice">
    <enonce>Si on déclare "Tab : TABLEAU [1 .. 5] d'Entier", l'instruction "Tab[6] &lt;- 10" est :</enonce>
    <choices>
      <choice id="A">An array stored in non-contiguous memory</choice>
      <choice id="B">A 2D array where each row can have a different length</choice>
      <choice id="C">An array with all elements equal</choice>
      <choice id="D">An array that cannot be sorted</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q24" type="multipleChoice">
    <enonce>Dans l'algorithme d'addition de deux matrices de dimensions 10x20, combien de boucles POUR sont utilisées pour l'addition ?</enonce>
    <choices>
      <choice id="A">To sort the matrix rows</choice>
      <choice id="B">To convert a 2D array into a 1D array</choice>
      <choice id="C">To remove all zero elements</choice>
      <choice id="D">To transpose the matrix</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q25" type="multipleChoice">
    <enonce>La recherche séquentielle dans un vecteur non trié a une complexité :</enonce>
    <choices>
      <choice id="A">i + j</choice>
      <choice id="B">i * n + j</choice>
      <choice id="C">j * n + i</choice>
      <choice id="D">i * j</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q28" type="ordering">
    <enonce>Remettez dans l'ordre la déclaration correcte d'un vecteur :</enonce>
    <bonneReponse>VAR|Tab|TABLEAU|[1..N]|DE|Entier</bonneReponse>
    <codeLines>
      <line>TABLEAU</line>
      <line>DE</line>
      <line>[1..N]</line>
      <line>Entier</line>
      <line>VAR</line>
      <line>Tab</line>
    </codeLines>
  </question>

  <!-- ==================== QUESTIONS DE COMPRÉHENSION ==================== -->
  <question id="q29" type="multipleChoice">
    <enonce>Dans l'algorithme de la moyenne, l'utilisation d'un vecteur plutôt que 15 variables séparées présente quel avantage ?</enonce>
    <choices>
      <choice id="A">Rend l'algorithme plus long et plus complexe</choice>
      <choice id="B">Permet d'utiliser des boucles pour traiter les notes</choice>
      <choice id="C">Limite le nombre de notes à 15 exactement</choice>
      <choice id="D">Empêche la manipulation des notes</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q30" type="multipleChoice">
    <enonce>L'allocation dynamique garantit :</enonce>
    <choices>
      <choice id="A">Arrays use more memory than linked lists</choice>
      <choice id="B">Fixed size — difficult to insert or delete elements efficiently</choice>
      <choice id="C">Slower element access</choice>
      <choice id="D">Elements cannot be sorted</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

</chapter>