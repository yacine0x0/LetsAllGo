<?xml version="1.0" encoding="UTF-8"?>
<chapter id="Chapitre_04" title="Data Structures - Structures de données">

  <question id="c4_q1" type="multipleChoice">
    <enonce>What is a vector?</enonce>
    <choices>
      <choice id="A">A fixed-size array</choice>
      <choice id="B">A dynamic array that can grow or shrink</choice>
      <choice id="C">A constant value</choice>
      <choice id="D">A function parameter</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c4_q2" type="multipleChoice">
    <enonce>What is the time complexity of accessing an element in an array?</enonce>
    <choices>
      <choice id="A">O(n)</choice>
      <choice id="B">O(log n)</choice>
      <choice id="C">O(1)</choice>
      <choice id="D">O(n²)</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c4_q3" type="multipleChoice">
    <enonce>What is a matrix?</enonce>
    <choices>
      <choice id="A">A one-dimensional array</choice>
      <choice id="B">A two-dimensional array</choice>
      <choice id="C">A dynamic array</choice>
      <choice id="D">A type of vector</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c4_q4" type="ordering">
    <enonce>Order the steps for matrix traversal:</enonce>
    <bonneReponse>Initialize row index|Initialize column index|Access element|Move to next element</bonneReponse>
    <codeLines>
      <line>Access element</line>
      <line>Initialize row index</line>
      <line>Move to next element</line>
      <line>Initialize column index</line>
    </codeLines>
  </question>

  <question id="c4_q5" type="multipleChoice">
    <enonce>What is the advantage of using vectors over arrays?</enonce>
    <choices>
      <choice id="A">Faster access</choice>
      <choice id="B">Dynamic sizing</choice>
      <choice id="C">Less memory usage</choice>
      <choice id="D">No advantages</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c4_q6" type="multipleChoice">
    <enonce>What is the index of the first element in an array?</enonce>
    <choices>
      <choice id="A">1</choice>
      <choice id="B">-1</choice>
      <choice id="C">0</choice>
      <choice id="D">Depends on the language</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c4_q7" type="multipleChoice">
    <enonce>What happens when you access an index out of bounds in an array?</enonce>
    <choices>
      <choice id="A">Returns 0</choice>
      <choice id="B">Returns null</choice>
      <choice id="C">An error or exception is thrown</choice>
      <choice id="D">The array resizes automatically</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c4_q8" type="multipleChoice">
    <enonce>What is the time complexity of inserting an element at the beginning of an array?</enonce>
    <choices>
      <choice id="A">O(1)</choice>
      <choice id="B">O(log n)</choice>
      <choice id="C">O(n)</choice>
      <choice id="D">O(n²)</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c4_q9" type="multipleChoice">
    <enonce>How do you calculate the number of elements in a matrix of size m x n?</enonce>
    <choices>
      <choice id="A">m + n</choice>
      <choice id="B">m - n</choice>
      <choice id="C">m * n</choice>
      <choice id="D">m / n</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c4_q10" type="ordering">
    <enonce>Order the steps to insert an element into a vector:</enonce>
    <bonneReponse>Choose insertion position|Shift elements right|Insert new element|Update size</bonneReponse>
    <codeLines>
      <line>Insert new element</line>
      <line>Update size</line>
      <line>Choose insertion position</line>
      <line>Shift elements right</line>
    </codeLines>
  </question>

  <question id="c4_q11" type="multipleChoice">
    <enonce>What is the time complexity of deleting an element from the middle of an array?</enonce>
    <choices>
      <choice id="A">O(1)</choice>
      <choice id="B">O(log n)</choice>
      <choice id="C">O(n)</choice>
      <choice id="D">O(n²)</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c4_q12" type="multipleChoice">
    <enonce>How is a 2D array element accessed?</enonce>
    <choices>
      <choice id="A">array[i]</choice>
      <choice id="B">array[i][j]</choice>
      <choice id="C">array(i, j)</choice>
      <choice id="D">array.get(i, j)</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c4_q13" type="multipleChoice">
    <enonce>What is the last index of an array of size n?</enonce>
    <choices>
      <choice id="A">n</choice>
      <choice id="B">n+1</choice>
      <choice id="C">n-1</choice>
      <choice id="D">n/2</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c4_q14" type="multipleChoice">
    <enonce>What is a sparse matrix?</enonce>
    <choices>
      <choice id="A">A matrix with all elements equal to zero</choice>
      <choice id="B">A matrix where most elements are zero</choice>
      <choice id="C">A matrix with only one row</choice>
      <choice id="D">A matrix that cannot be traversed</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c4_q15" type="multipleChoice">
    <enonce>What is column-major order in matrix storage?</enonce>
    <choices>
      <choice id="A">Storing elements row by row</choice>
      <choice id="B">Storing elements column by column</choice>
      <choice id="C">Storing only non-zero elements</choice>
      <choice id="D">Storing elements in random order</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c4_q16" type="multipleChoice">
    <enonce>What is the memory layout of a 1D array?</enonce>
    <choices>
      <choice id="A">Random locations in memory</choice>
      <choice id="B">Contiguous (consecutive) memory locations</choice>
      <choice id="C">Linked nodes in memory</choice>
      <choice id="D">Stored on the hard disk</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c4_q17" type="multipleChoice">
    <enonce>What is the time complexity of appending an element to the end of a dynamic array (vector)?</enonce>
    <choices>
      <choice id="A">O(n)</choice>
      <choice id="B">O(log n)</choice>
      <choice id="C">O(n²)</choice>
      <choice id="D">O(1) amortized</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="c4_q18" type="multipleChoice">
    <enonce>What does "row-major order" mean?</enonce>
    <choices>
      <choice id="A">Storing matrix elements column by column</choice>
      <choice id="B">Storing matrix elements row by row in memory</choice>
      <choice id="C">Accessing only the first row</choice>
      <choice id="D">Sorting rows before storing</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c4_q19" type="multipleChoice">
    <enonce>What is the size of a 3x4 matrix?</enonce>
    <choices>
      <choice id="A">7 elements</choice>
      <choice id="B">3 elements</choice>
      <choice id="C">4 elements</choice>
      <choice id="D">12 elements</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="c4_q20" type="ordering">
    <enonce>Order the steps to search for an element in an unsorted array:</enonce>
    <bonneReponse>Start at index 0|Compare element with target|If match: return index|If not: move to next index|If end reached: return -1</bonneReponse>
    <codeLines>
      <line>If match: return index</line>
      <line>Start at index 0</line>
      <line>If end reached: return -1</line>
      <line>If not: move to next index</line>
      <line>Compare element with target</line>
    </codeLines>
  </question>

  <question id="c4_q21" type="multipleChoice">
    <enonce>What is the diagonal of a square matrix?</enonce>
    <choices>
      <choice id="A">The first row of the matrix</choice>
      <choice id="B">Elements where the row index equals the column index</choice>
      <choice id="C">The last column of the matrix</choice>
      <choice id="D">Elements at even positions</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c4_q22" type="multipleChoice">
    <enonce>What happens to the size of a dynamic array when it exceeds its capacity?</enonce>
    <choices>
      <choice id="A">An error is thrown</choice>
      <choice id="B">The oldest element is removed</choice>
      <choice id="C">It reallocates with a larger capacity (typically doubles)</choice>
      <choice id="D">The array becomes fixed-size</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c4_q23" type="multipleChoice">
    <enonce>How do you find the transpose of a matrix?</enonce>
    <choices>
      <choice id="A">Multiply all elements by -1</choice>
      <choice id="B">Reverse all rows</choice>
      <choice id="C">Swap rows and columns (matrix[i][j] becomes matrix[j][i])</choice>
      <choice id="D">Add the matrix to itself</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c4_q24" type="multipleChoice">
    <enonce>What is an identity matrix?</enonce>
    <choices>
      <choice id="A">A matrix filled with 1s</choice>
      <choice id="B">A matrix with 1s on the diagonal and 0s elsewhere</choice>
      <choice id="C">A matrix with all zeros</choice>
      <choice id="D">A matrix where all rows are equal</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c4_q25" type="multipleChoice">
    <enonce>What is the time complexity of searching for an element in a sorted array using binary search?</enonce>
    <choices>
      <choice id="A">O(n)</choice>
      <choice id="B">O(1)</choice>
      <choice id="C">O(n²)</choice>
      <choice id="D">O(log n)</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="c4_q26" type="multipleChoice">
    <enonce>What is a jagged array?</enonce>
    <choices>
      <choice id="A">An array with all elements equal</choice>
      <choice id="B">A 2D array where each row can have a different length</choice>
      <choice id="C">An array that cannot be sorted</choice>
      <choice id="D">An array stored in non-contiguous memory</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c4_q27" type="multipleChoice">
    <enonce>What does it mean to "flatten" a matrix?</enonce>
    <choices>
      <choice id="A">To remove all zero elements</choice>
      <choice id="B">To sort the matrix rows</choice>
      <choice id="C">To convert a 2D array into a 1D array</choice>
      <choice id="D">To transpose the matrix</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c4_q28" type="multipleChoice">
    <enonce>What is the index formula for element at row i, column j in a row-major matrix of width n?</enonce>
    <choices>
      <choice id="A">i + j</choice>
      <choice id="B">i * j</choice>
      <choice id="C">i * n + j</choice>
      <choice id="D">j * n + i</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c4_q29" type="ordering">
    <enonce>Order the steps to delete an element at position k from an array of size n:</enonce>
    <bonneReponse>Identify position k|Shift elements left from k+1 to n-1|Decrease array size by 1</bonneReponse>
    <codeLines>
      <line>Shift elements left from k+1 to n-1</line>
      <line>Identify position k</line>
      <line>Decrease array size by 1</line>
    </codeLines>
  </question>

  <question id="c4_q30" type="multipleChoice">
    <enonce>What is the main disadvantage of arrays compared to linked lists?</enonce>
    <choices>
      <choice id="A">Slower element access</choice>
      <choice id="B">Fixed size — difficult to insert or delete elements efficiently</choice>
      <choice id="C">Elements cannot be sorted</choice>
      <choice id="D">Arrays use more memory than linked lists</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

</chapter>
