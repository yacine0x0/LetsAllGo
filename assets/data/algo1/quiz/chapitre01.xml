<?xml version="1.0" encoding="UTF-8"?>
<chapter id="Chapitre_01_Quiz" title="Quiz – Éléments de base d'algorithmique">

  <!-- ==================== PAGE 6 ==================== -->
  <question id="q1" type="multipleChoice">
    <enonce>En algorithmique, toutes les données à traiter sont d'une même nature.</enonce>
    <choices>
      <choice id="A">A step-by-step procedure for solving a problem</choice>
      <choice id="B">A programming language</choice>
      <choice id="C">A data structure</choice>
      <choice id="D">A type of computer</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q2" type="multipleChoice">
    <enonce>L'instruction qui permet de lire une donnée simple à partir du clavier est l'instruction SI ... SINON.</enonce>
    <choices>
      <choice id="A">Ambiguity</choice>
      <choice id="B">Finiteness</choice>
      <choice id="C">Effectiveness</choice>
      <choice id="D">Definiteness</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="c1_q3" type="multipleChoice">
    <enonce>What is the time complexity of searching in an unsorted array?</enonce>
    <choices>
      <choice id="A">O(log n)</choice>
      <choice id="B">O(n²)</choice>
      <choice id="C">O(1)</choice>
      <choice id="D">O(n)</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="q3" type="multipleChoice">
    <enonce>L'instruction LIRE est une instruction d'opération.</enonce>
    <choices>
      <choice id="A">O(n log n)</choice>
      <choice id="B">O(n)</choice>
      <choice id="C">O(1)</choice>
      <choice id="D">O(log n)</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <!-- ==================== PAGE 7 ==================== -->
  <question id="q4" type="multipleChoice">
    <enonce>Un algorithme présente une solution automatique à un problème.</enonce>
    <choices>
      <choice id="A">The number of lines of code</choice>
      <choice id="B">CPU speed</choice>
      <choice id="C">Memory usage</choice>
      <choice id="D">Time complexity in worst case</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="q5" type="multipleChoice">
    <enonce>Un algorithme peut s'exécuter sur un ordinateur.</enonce>
    <choices>
      <choice id="A">Linear Search</choice>
      <choice id="B">Hash Table</choice>
      <choice id="C">Bubble Sort</choice>
      <choice id="D">Binary Search</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q6" type="multipleChoice">
    <enonce>Un algorithme contient souvent plusieurs types d'instructions.</enonce>
    <choices>
      <choice id="A">The amount of memory the algorithm needs to run</choice>
      <choice id="B">The execution time of the algorithm</choice>
      <choice id="C">The number of variables declared</choice>
      <choice id="D">The number of loops used</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
    <bonneReponse>A</bonneReponse>
  </question>

  <!-- ==================== PAGE 8 ==================== -->
  <question id="q7" type="multipleChoice">
    <enonce>L'unité centrale est un composant software.</enonce>
    <choices>
      <choice id="A">A compiled programming language</choice>
      <choice id="B">A debugging tool</choice>
      <choice id="C">A type of binary code</choice>
      <choice id="D">An informal high-level description of an algorithm</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="q8" type="multipleChoice">
    <enonce>Le clavier d'un ordinateur :</enonce>
    <choices>
      <choice id="A">The algorithm runs in logarithmic time</choice>
      <choice id="B">The algorithm's time grows quadratically with input size</choice>
      <choice id="C">The algorithm runs in constant time</choice>
      <choice id="D">The algorithm's time grows linearly</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <!-- ==================== PAGE 14 ==================== -->
  <question id="q9" type="multipleChoice">
    <enonce>Un algorithme se construit :</enonce>
    <choices>
      <choice id="A">Après l'écriture d'un programme</choice>
      <choice id="B">Avant l'écriture d'un programme</choice>
      <choice id="C">L'ordre n'a pas d'importance</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <!-- ==================== PAGE 25 ==================== -->
  <question id="q10" type="multipleChoice">
    <enonce>Quelle est l'écriture qui permet d'ajouter 5 à la variable "prix" ?</enonce>
    <choices>
      <choice id="A">O(n²)</choice>
      <choice id="B">O(log n)</choice>
      <choice id="C">O(n)</choice>
      <choice id="D">O(1)</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c1_q12" type="multipleChoice">
    <enonce>Which data structure uses LIFO order?</enonce>
    <choices>
      <choice id="A">Array</choice>
      <choice id="B">Tree</choice>
      <choice id="C">Queue</choice>
      <choice id="D">Stack</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <!-- ==================== PAGE 30 ==================== -->
  <question id="q13" type="multipleChoice">
    <enonce>Quelle est la différence entre une variable et une constante ?</enonce>
    <choices>
      <choice id="A">O(n log n)</choice>
      <choice id="B">O(n)</choice>
      <choice id="C">O(log n)</choice>
      <choice id="D">O(n²)</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <!-- ==================== PAGE 32 ==================== -->
  <question id="q14" type="multipleChoice">
    <enonce>Après exécution de : a←7, b←-5, c←a-b, c←c+a, quelle est la valeur de c ?</enonce>
    <choices>
      <choice id="A">It runs without errors</choice>
      <choice id="B">It uses the least memory</choice>
      <choice id="C">It produces the right output for every valid input</choice>
      <choice id="D">It is written in the shortest way</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q15" type="multipleChoice">
    <enonce>Pour déclarer la constante X=2, il faut écrire :</enonce>
    <choices>
      <choice id="A">Big Theta</choice>
      <choice id="B">Big O</choice>
      <choice id="C">Little o</choice>
      <choice id="D">Big Omega</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <!-- ==================== QUESTIONS SUPPLÉMENTAIRES (petits ajouts) ==================== -->
  <question id="q16" type="multipleChoice">
    <enonce>Le type de donnée pour 'A' (entre apostrophes) est :</enonce>
    <choices>
      <choice id="A">An algorithm is language-independent; a program is written in a specific language</choice>
      <choice id="B">A program is faster than an algorithm</choice>
      <choice id="C">There is no difference</choice>
      <choice id="D">An algorithm can only be written in pseudocode</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q17" type="multipleChoice">
    <enonce>Lequel de ces opérateurs est utilisé pour la division entière ?</enonce>
    <choices>
      <choice id="A">Accessing an array element by index</choice>
      <choice id="B">Binary search</choice>
      <choice id="C">Linear search</choice>
      <choice id="D">Sorting an array</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q18" type="multipleChoice">
    <enonce>Lequel de ces opérateurs donne le reste d'une division ?</enonce>
    <choices>
      <choice id="A">To visually represent the steps of an algorithm</choice>
      <choice id="B">To measure execution time</choice>
      <choice id="C">To debug programs</choice>
      <choice id="D">To write code faster</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q19" type="multipleChoice">
    <enonce>Quelle affectation est autorisée ?</enonce>
    <choices>
      <choice id="A">The code written by the programmer</choice>
      <choice id="B">The result produced by the algorithm</choice>
      <choice id="C">The memory used by the algorithm</choice>
      <choice id="D">The data provided to the algorithm to process</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="q20" type="multipleChoice">
    <enonce>Une variable booléenne peut valoir :</enonce>
    <choices>
      <choice id="A">O(n²)</choice>
      <choice id="B">O(log n)</choice>
      <choice id="C">O(n)</choice>
      <choice id="D">O(1)</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q21" type="multipleChoice">
    <enonce>Que fait l'instruction ÉCRIRE( "Bonjour" ) ?</enonce>
    <choices>
      <choice id="A">Using memory to store results of subproblems</choice>
      <choice id="B">Solving a problem by trying all possible solutions</choice>
      <choice id="C">Breaking a problem into smaller subproblems and combining solutions</choice>
      <choice id="D">Using a loop to repeat the same operation</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="c1_q23" type="multipleChoice">
    <enonce>What is the worst-case time complexity of Merge Sort?</enonce>
    <choices>
      <choice id="A">O(log n)</choice>
      <choice id="B">O(n log n)</choice>
      <choice id="C">O(n)</choice>
      <choice id="D">O(n²)</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q24" type="multipleChoice">
    <enonce>Un identificateur valide doit :</enonce>
    <choices>
      <choice id="A">An algorithm that explores all possible paths</choice>
      <choice id="B">An algorithm that always runs in O(1)</choice>
      <choice id="C">An algorithm that makes the locally optimal choice at each step</choice>
      <choice id="D">An algorithm that uses the most memory</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q25" type="multipleChoice">
    <enonce>L'instruction "LIRE(5)" est :</enonce>
    <choices>
      <choice id="A">Programming with dynamic typing</choice>
      <choice id="B">A technique that stores results of subproblems to avoid recomputation</choice>
      <choice id="C">Writing code that changes at runtime</choice>
      <choice id="D">A method to dynamically allocate memory</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="c1_q26" type="multipleChoice">
    <enonce>If an algorithm has O(log n) complexity, how does its runtime grow as n doubles?</enonce>
    <choices>
      <choice id="A">It quadruples</choice>
      <choice id="B">It doubles</choice>
      <choice id="C">It stays the same</choice>
      <choice id="D">It increases by a constant amount</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <!-- ==================== QUESTIONS DE TRACE ==================== -->
  <question id="q28" type="multipleChoice">
    <enonce>Si X←3, Y←7, Z←X, X←Y, alors que vaut Z ?</enonce>
    <choices>
      <choice id="A">They use the same amount of memory</choice>
      <choice id="B">They produce identical output</choice>
      <choice id="C">They always run in exactly the same time</choice>
      <choice id="D">Their runtime grows at the same rate as input size increases</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="q29" type="multipleChoice">
    <enonce>La trace d'exécution permet de :</enonce>
    <choices>
      <choice id="A">Greedy</choice>
      <choice id="B">Dynamic programming</choice>
      <choice id="C">Divide and conquer</choice>
      <choice id="D">Brute force</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="q30" type="multipleChoice">
    <enonce>L'instruction ÉCRIRE (a, '+', b, '=', a+b) avec a=3, b=1 affiche :</enonce>
    <choices>
      <choice id="A">To reduce time and/or space complexity</choice>
      <choice id="B">To add more comments</choice>
      <choice id="C">To make the code shorter</choice>
      <choice id="D">To use more variables</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

</chapter>