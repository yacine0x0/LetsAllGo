<?xml version="1.0" encoding="UTF-8"?>
<chapter id="Chapitre_01_Quiz" title="Quiz – Éléments de base d'algorithmique">

  <!-- ==================== PAGE 6 ==================== -->
  <question id="q1" type="multipleChoice">
    <enonce>En algorithmique, toutes les données à traiter sont d'une même nature.</enonce>
    <choices>
      <choice id="A">Vrai</choice>
      <choice id="B">Faux</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q2" type="multipleChoice">
    <enonce>L'instruction qui permet de lire une donnée simple à partir du clavier est l'instruction SI ... SINON.</enonce>
    <choices>
      <choice id="A">Vrai</choice>
      <choice id="B">Faux</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q3" type="multipleChoice">
    <enonce>L'instruction LIRE est une instruction d'opération.</enonce>
    <choices>
      <choice id="A">Vrai</choice>
      <choice id="B">Faux</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <!-- ==================== PAGE 7 ==================== -->
  <question id="q4" type="multipleChoice">
    <enonce>Un algorithme présente une solution automatique à un problème.</enonce>
    <choices>
      <choice id="A">Vrai</choice>
      <choice id="B">Faux</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q5" type="multipleChoice">
    <enonce>Un algorithme peut s'exécuter sur un ordinateur.</enonce>
    <choices>
      <choice id="A">Vrai</choice>
      <choice id="B">Faux</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q6" type="multipleChoice">
    <enonce>Un algorithme contient souvent plusieurs types d'instructions.</enonce>
    <choices>
      <choice id="A">Vrai</choice>
      <choice id="B">Faux</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <!-- ==================== PAGE 8 ==================== -->
  <question id="q7" type="multipleChoice">
    <enonce>L'unité centrale est un composant software.</enonce>
    <choices>
      <choice id="A">Vrai</choice>
      <choice id="B">Faux</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q8" type="multipleChoice">
    <enonce>Le clavier d'un ordinateur :</enonce>
    <choices>
      <choice id="A">Est un composant hardware</choice>
      <choice id="B">Fait partie des unités d'entrée/sortie</choice>
      <choice id="C">A et B</choice>
      <choice id="D">Fait partie des unités de traitement</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <!-- ==================== PAGE 14 ==================== -->
  <question id="q9" type="multipleChoice">
    <enonce>Un algorithme se construit :</enonce>
    <choices>
      <choice id="A">Après l'écriture d'un programme</choice>
      <choice id="B">Avant l'écriture d'un programme</choice>
      <choice id="C">L'ordre n'a pas d'importance</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <!-- ==================== PAGE 25 ==================== -->
  <question id="q10" type="multipleChoice">
    <enonce>Quelle est l'écriture qui permet d'ajouter 5 à la variable "prix" ?</enonce>
    <choices>
      <choice id="A">prix ← 5 ;</choice>
      <choice id="B">prix ← prix * prix ;</choice>
      <choice id="C">prix ← prix + 5 ;</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <!-- ==================== PAGE 28 ==================== -->
  <question id="q11" type="multipleChoice">
    <enonce>L'instruction qui permet d'attribuer une valeur à la variable "nom" à partir du clavier est :</enonce>
    <choices>
      <choice id="A">LIRE(nom) ;</choice>
      <choice id="B">ÉCRIRE(nom) ;</choice>
      <choice id="C">nom ← 'Kamel' ;</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <!-- ==================== PAGE 29 ==================== -->
  <question id="q12" type="multipleChoice">
    <enonce>Un algorithme permet :</enonce>
    <choices>
      <choice id="A">Mieux comprendre le fonctionnement des logiciels</choice>
      <choice id="B">Par une suite finie d'instructions résoudre un problème</choice>
      <choice id="C">Définir l'architecture d'un ordinateur</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <!-- ==================== PAGE 30 ==================== -->
  <question id="q13" type="multipleChoice">
    <enonce>Quelle est la différence entre une variable et une constante ?</enonce>
    <choices>
      <choice id="A">Aucune différence</choice>
      <choice id="B">La variable ne change jamais de nom, la constante change toujours</choice>
      <choice id="C">La valeur d'une variable varie durant l'algorithme</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <!-- ==================== PAGE 32 ==================== -->
  <question id="q14" type="multipleChoice">
    <enonce>Après exécution de : a←7, b←-5, c←a-b, c←c+a, quelle est la valeur de c ?</enonce>
    <choices>
      <choice id="A">19</choice>
      <choice id="B">12</choice>
      <choice id="C">-12</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q15" type="multipleChoice">
    <enonce>Pour déclarer la constante X=2, il faut écrire :</enonce>
    <choices>
      <choice id="A">VARIABLE X=2;</choice>
      <choice id="B">CONST X=2;</choice>
      <choice id="C">X ← 2;</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <!-- ==================== QUESTIONS SUPPLÉMENTAIRES (petits ajouts) ==================== -->
  <question id="q16" type="multipleChoice">
    <enonce>Le type de donnée pour 'A' (entre apostrophes) est :</enonce>
    <choices>
      <choice id="A">Entier</choice>
      <choice id="B">Caractère</choice>
      <choice id="C">Chaîne</choice>
      <choice id="D">Booléen</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q17" type="multipleChoice">
    <enonce>Lequel de ces opérateurs est utilisé pour la division entière ?</enonce>
    <choices>
      <choice id="A">/</choice>
      <choice id="B">DIV</choice>
      <choice id="C">MOD</choice>
      <choice id="D">%</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q18" type="multipleChoice">
    <enonce>Lequel de ces opérateurs donne le reste d'une division ?</enonce>
    <choices>
      <choice id="A">DIV</choice>
      <choice id="B">MOD</choice>
      <choice id="C">/</choice>
      <choice id="D">*</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q19" type="multipleChoice">
    <enonce>Quelle affectation est autorisée ?</enonce>
    <choices>
      <choice id="A">Entier ← Réel</choice>
      <choice id="B">Réel ← Entier</choice>
      <choice id="C">Caractère ← Chaîne</choice>
      <choice id="D">Chaîne ← Booléen</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q20" type="multipleChoice">
    <enonce>Une variable booléenne peut valoir :</enonce>
    <choices>
      <choice id="A">VRAI ou FAUX</choice>
      <choice id="B">0 ou 1</choice>
      <choice id="C">OUI ou NON</choice>
      <choice id="D">A et B</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q21" type="multipleChoice">
    <enonce>Que fait l'instruction ÉCRIRE( "Bonjour" ) ?</enonce>
    <choices>
      <choice id="A">Lit "Bonjour"</choice>
      <choice id="B">Affiche "Bonjour"</choice>
      <choice id="C">Déclare une variable</choice>
      <choice id="D">Provoque une erreur</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <question id="q22" type="multipleChoice">
    <enonce>Dans un algorithme, le mot clé VARIABLE annonce :</enonce>
    <choices>
      <choice id="A">Le nom de l'algorithme</choice>
      <choice id="B">La déclaration des constantes</choice>
      <choice id="C">La déclaration des variables</choice>
      <choice id="D">La fin de l'algorithme</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q23" type="multipleChoice">
    <enonce>Les instructions d'un algorithme s'exécutent :</enonce>
    <choices>
      <choice id="A">En parallèle</choice>
      <choice id="B">Aléatoirement</choice>
      <choice id="C">Séquentiellement</choice>
      <choice id="D">En ordre inverse</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q24" type="multipleChoice">
    <enonce>Un identificateur valide doit :</enonce>
    <choices>
      <choice id="A">Commencer par une lettre</choice>
      <choice id="B">Être alphanumérique</choice>
      <choice id="C">Ne pas contenir de caractères spéciaux (+, -, etc.)</choice>
      <choice id="D">Toutes ces réponses</choice>
    </choices>
    <bonneReponse>D</bonneReponse>
  </question>

  <question id="q25" type="multipleChoice">
    <enonce>L'instruction "LIRE(5)" est :</enonce>
    <choices>
      <choice id="A">Correcte</choice>
      <choice id="B">Incorrecte car on ne peut pas lire une constante</choice>
      <choice id="C">Incorrecte car on ne peut pas lire une expression</choice>
      <choice id="D">B et C</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

  <!-- ==================== ORDRE ==================== -->
  <question id="q26" type="ordering">
    <enonce>Remettez dans l'ordre les 4 étapes de la résolution automatique d'un problème :</enonce>
    <bonneReponse>Analyse|Algorithme|Programmation|Édition</bonneReponse>
    <codeLines>
      <line>Programmation</line>
      <line>Analyse</line>
      <line>Édition</line>
      <line>Algorithme</line>
    </codeLines>
  </question>

  <question id="q27" type="ordering">
    <enonce>Remettez dans l'ordre les parties d'un algorithme (de la première à la dernière) :</enonce>
    <bonneReponse>ALGORITHME|CONSTANTE|VARIABLE|DÉBUT|FIN</bonneReponse>
    <codeLines>
      <line>VARIABLE</line>
      <line>FIN</line>
      <line>ALGORITHME</line>
      <line>DÉBUT</line>
      <line>CONSTANTE</line>
    </codeLines>
  </question>

  <!-- ==================== QUESTIONS DE TRACE ==================== -->
  <question id="q28" type="multipleChoice">
    <enonce>Si X←3, Y←7, Z←X, X←Y, alors que vaut Z ?</enonce>
    <choices>
      <choice id="A">3</choice>
      <choice id="B">7</choice>
      <choice id="C">X</choice>
      <choice id="D">Y</choice>
    </choices>
    <bonneReponse>A</bonneReponse>
  </question>

  <question id="q29" type="multipleChoice">
    <enonce>La trace d'exécution permet de :</enonce>
    <choices>
      <choice id="A">Vérifier les valeurs des variables</choice>
      <choice id="B">S'assurer que l'algorithme se termine</choice>
      <choice id="C">A et B</choice>
      <choice id="D">Générer automatiquement le code</choice>
    </choices>
    <bonneReponse>C</bonneReponse>
  </question>

  <question id="q30" type="multipleChoice">
    <enonce>L'instruction ÉCRIRE (a, '+', b, '=', a+b) avec a=3, b=1 affiche :</enonce>
    <choices>
      <choice id="A">a+b=4</choice>
      <choice id="B">3+1=4</choice>
      <choice id="C">3 plus 1 = 4</choice>
      <choice id="D">Erreur</choice>
    </choices>
    <bonneReponse>B</bonneReponse>
  </question>

</chapter>